{
  "name": "@asla/pg",
  "version": "0.2.5",
  "license": "MIT",
  "nodeModulesDir": "manual",
  "tasks": {
    "doc:html": "deno doc --name=@asla/pg --html --output docs/html src/mod.ts",
    "doc:json": "deno doc --name=@asla/pg --json src/mod.ts >> docs/doc.json",
    "type:check": "deno check",
    "ci:test": "deno x vitest run",
    "test:coverage": "deno x vitest run --coverage",
    "publishDry": "deno publish --dry-run --allow-dirty",
    "bundle": "deno bundle src/mod.ts -o dist/mod.js",
    "transpile": "deno transpile src/**/*.ts --outdir dist --declaration"
  },
  "imports": {
    "#abstract": "./src/abstract/mod.ts",
    "@types/node": "npm:@types/node@^26.5.0",
    "@asla/pg": "./src/mod.ts",
    "@/": "./src/",
    "@test/": "./test/",
    "@vitest/coverage-v8": "npm:@vitest/coverage-v8@^5.0.1",

    "vitest": "npm:vitest@^5.0.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3"
  },
  "exports": "./src/mod.ts",
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "exclude": ["require-await", "no-unused-vars"]
    }
  },
  "test": {
    "include": []
  },
  "publish": {
    "include": ["README.md", "CHANGELOG.md", "LICENSE", "docs/migration-native-protocol.md", "src"]
  },
  "exclude": ["./benchmark", "./dist", "./bench2"]
}
