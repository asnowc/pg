{
  "name": "@asla/pg",
  "version": "0.2.3",
  "license": "MIT",
  "nodeModulesDir": "manual",
  "tasks": {
    "type:check": "deno check",
    "ci:test": "deno x vitest run",
    "publishDry": "deno publish --dry-run --allow-dirty"
  },
  "imports": {
    "#abstract": "./src/abstract/mod.ts",
    "@types/pg": "npm:@types/pg@^8.20.0",
    "@types/pg-cursor": "npm:@types/pg-cursor@^2.7.2",
    "pg": "npm:pg@^8.20.0",
    "pg-cursor": "npm:pg-cursor@^2.19.0",

    "@asla/pg": "./src/mod.ts",
    "@/": "./src/",
    "@test/": "./test/",

    "vitest": "npm:vitest@^4.1.1",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "fmt": {
    "lineWidth": 120
  },
  "publish": {
    "include": ["README.md", "LICENSE", "src"]
  }
}
