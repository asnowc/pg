{
  "name": "@asla/pg",
  "version": "0.2.5",
  "license": "MIT",
  "nodeModulesDir": "manual",
  "tasks": {
    "type:check": "deno check",
    "ci:test": "deno x vitest run",
    "publishDry": "deno publish --dry-run --allow-dirty"
  },
  "imports": {
    "#abstract": "./src/abstract/mod.ts",
    "@types/node": "npm:@types/node@^24.2.0",
    "@asla/pg": "./src/mod.ts",
    "@/": "./src/",
    "@test/": "./test/",

    "vitest": "npm:vitest@^4.1.11",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3"
  },
  "exports": "./src/mod.ts",
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    }
  },
  "test": {
    "include": []
  },
  "publish": {
    "include": ["README.md", "CHANGELOG.md", "LICENSE", "docs/migration-native-protocol.md", "src"]
  }
}
