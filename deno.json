{
  "name": "@asla/pg",
  "version": "0.2.5",
  "license": "MIT",
  "nodeModulesDir": "manual",
  "tasks": {
    "doc:html": "deno doc --name=@asla/pg --html --output docs/html src/mod.ts",
    "doc:json": "deno doc --name=@asla/pg --json src/mod.ts >> docs/doc.json",
    "publishDry": "deno publish --dry-run --allow-dirty",
    "transpile": "deno transpile src/mod.ts --outdir dist  --declaration src/**/*.ts",
    "bench": "deno run -A benchmark/deps/bench-cli.ts",
    "bench:pg-client": "deno task bench run -d 4000 -s @asla/pg,postgres,pg-promise,pg,slonik benchmark/test/postgresql-client.bench.ts",
    "bench:primary": "deno task bench run -d 4000 -s @asla/pg,postgres,pg benchmark/test/postgresql-client.bench.ts",
    "bench:fake-primary": "deno task bench run -d 4000 -s fake2,postgres,pg benchmark/test/postgresql-client.bench.ts",
    "bench:vs-fake": "deno task bench run -d 4000 -s @asla/pg,fake2 benchmark/test/postgresql-client.bench.ts",
    "bench:vs-old": "deno task bench run -d 4000 -s @asla/pg-prev,@asla/pg benchmark/test/postgresql-client.bench.ts"
  },
  "imports": {
    "#abstract": "./src/abstract/mod.ts",
    "@types/node": "npm:@types/node@^26.5.0",
    "@asla/pg-prev": "./dist/mod.js",
    "@asla/pg": "./src/mod.ts",
    "@/": "./src/"
  },
  "exports": "./src/mod.ts",
  "fmt": {
    "lineWidth": 120
  },
  "test": {
    "include": []
  },
  "compilerOptions": {
    "lib": ["deno.window"]
  },
  "publish": {
    "include": ["README.md", "CHANGELOG.md", "LICENSE", "src"]
  },
  "exclude": ["./benchmark", "./dist", "./test"]
}
